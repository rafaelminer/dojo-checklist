# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# Deixe em branco para usar o backend local do Vite (POST /actions).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Chave pública VAPID para notificações push (mesma de VAPID_PUBLIC_KEY no servidor).
VITE_VAPID_PUBLIC_KEY=

# Somente no servidor (Vercel), nunca no front-end:
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contato@dojo.local
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
