# Modo recomendado (produção): proxy server-side na Vercel.
# O navegador chama /api/actions; a service_role fica só no servidor.
VITE_ACTIONS_URL=

# Variáveis somente da Vercel (nunca no front-end):
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=

# Modo antigo (acesso direto ao Supabase) — use apenas em dev local, se RLS permitir.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Chave pública VAPID para notificações push (mesma de VAPID_PUBLIC_KEY no servidor).
VITE_VAPID_PUBLIC_KEY=
